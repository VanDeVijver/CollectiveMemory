@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var active = controller switch
    {
        "Songbook" => "songbook",
        "Setlists" => "setlists",
        _ => action is "Clips" or "CreateClip" ? "clips" : "shows"
    };
    string Cls(string tab) => active == tab ? "btn-primary" : "btn-outline-light";
}
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-sm @Cls("shows")">Shows</a>
    <a asp-controller="Admin" asp-action="Clips" class="btn btn-sm @Cls("clips")">Clips</a>
    <a asp-controller="Songbook" asp-action="Index" class="btn btn-sm @Cls("songbook")">Songbook</a>
    <a asp-controller="Setlists" asp-action="Index" class="btn btn-sm @Cls("setlists")">Setlists</a>
</div>
