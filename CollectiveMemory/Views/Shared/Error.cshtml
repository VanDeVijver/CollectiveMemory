@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="cm-section text-center">
    <div class="container">
        <h1 class="cm-hero-title">Oops</h1>
        <h2 class="cm-section-title">Something went wrong</h2>
        <p class="cm-section-lead mx-auto">
            An error occurred while processing your request. Please try again in a moment.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">Reference: <code>@Model.RequestId</code></p>
        }
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Back to home</a>
        </div>
    </div>
</section>
