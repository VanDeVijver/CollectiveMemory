@model CollectiveMemory.ViewModels.SetlistsIndexViewModel
@{
    ViewData["Title"] = "Setlists";
}

<section class="cm-section">
    <div class="container">
        <partial name="_AdminTabs" />

        <h1 class="cm-section-title">Setlists</h1>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <p class="cm-section-lead">
            Pick a show to plan its setlist. Setlists are only visible to logged-in band members.
        </p>

        <h2 class="cm-section-subtitle mt-4">Upcoming shows</h2>
        <div class="cm-shows-list mt-3">
            @if (Model.Upcoming.Any())
            {
                @foreach (var row in Model.Upcoming)
                {
                    <partial name="_SetlistShowRow" model="row" />
                }
            }
            else
            {
                <div class="cm-shows-item is-muted">
                    <div>
                        <p class="cm-shows-date">No upcoming shows</p>
                        <p class="cm-shows-venue mb-0">Add a show on the Shows tab first.</p>
                    </div>
                </div>
            }
        </div>

        @if (Model.Past.Any())
        {
            <h2 class="cm-section-subtitle mt-5">Past shows</h2>
            <div class="cm-shows-list mt-3">
                @foreach (var row in Model.Past)
                {
                    <partial name="_SetlistShowRow" model="row" />
                }
            </div>
        }
    </div>
</section>
