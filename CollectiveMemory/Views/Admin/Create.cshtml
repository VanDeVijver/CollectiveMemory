@model CollectiveMemory.ViewModels.ShowFormViewModel
@{
    ViewData["Title"] = "Add a show";
}

<section class="cm-section">
    <div class="container" style="max-width: 40rem;">
        <h1 class="cm-section-title">Add a show</h1>
        <p class="cm-section-lead">Fill in the same details you see on a show card.</p>

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <form asp-action="Create" method="post" class="cm-newsletter-card">
            <div class="mb-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Venue" class="form-label"></label>
                    <input asp-for="Venue" class="form-control" placeholder="e.g. De Kiem" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" placeholder="e.g. Gavere" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StreetNumber" class="form-label"></label>
                    <input asp-for="StreetNumber" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
                <div class="form-text">Enter 0 for a free show.</div>
            </div>

            <div class="mb-3">
                <label asp-for="AdditionalInfo" class="form-label"></label>
                <textarea asp-for="AdditionalInfo" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="LinksText" class="form-label"></label>
                <textarea asp-for="LinksText" class="form-control" rows="2"
                          placeholder="https://www.facebook.com/..."></textarea>
                <div class="form-text">Optional. Each link appears as a "More info" button.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add show</button>
                <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
            </div>
        </form>
    </div>
</section>
