@model CollectiveMemory.ViewModels.AdminShowsViewModel
@{
    ViewData["Title"] = "Manage shows";
    ViewData["ShowDelete"] = true;
}

<section class="cm-section">
    <div class="container">
        <partial name="_AdminTabs" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h1 class="cm-section-title mb-0">Manage shows</h1>
            <a asp-action="Create" class="btn btn-primary">Add a show</a>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <p class="cm-section-lead">
            Shows appear on the website until their date has passed. This is how they look to visitors.
        </p>

        <h2 class="cm-section-subtitle mt-4">Upcoming</h2>
        <div class="cm-shows-list mt-3">
            @if (Model.Upcoming.Any())
            {
                @foreach (var show in Model.Upcoming)
                {
                    <partial name="_ShowItem" model="show" />
                }
            }
            else
            {
                <div class="cm-shows-item is-muted">
                    <div>
                        <p class="cm-shows-date">No upcoming shows</p>
                        <p class="cm-shows-venue mb-0">Use "Add a show" to announce the next one.</p>
                    </div>
                </div>
            }
        </div>

        @if (Model.Past.Any())
        {
            <h2 class="cm-section-subtitle mt-5">Past (hidden from visitors)</h2>
            <div class="cm-shows-list mt-3">
                @foreach (var show in Model.Past)
                {
                    <partial name="_ShowItem" model="show" />
                }
            </div>
        }
    </div>
</section>
