@model CollectiveMemory.ViewModels.ClipFormViewModel
@{
    ViewData["Title"] = "Add a clip";
}

<section class="cm-section">
    <div class="container" style="max-width: 40rem;">
        <h1 class="cm-section-title">Add a clip</h1>
        <p class="cm-section-lead">
            Upload a short video from your computer, or paste a YouTube link.
        </p>

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <form asp-action="CreateClip" method="post" enctype="multipart/form-data" class="cm-newsletter-card">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Teach Your Children" />
            </div>

            <div class="mb-3">
                <label asp-for="Subtitle" class="form-label"></label>
                <input asp-for="Subtitle" class="form-control" placeholder="e.g. Gavere · Apr 2026" />
                <div class="form-text">Optional. Shown under the title.</div>
            </div>

            <div class="mb-2">
                <label asp-for="VideoFile" class="form-label"></label>
                <input asp-for="VideoFile" type="file" class="form-control" accept="video/mp4,video/webm,.mp4,.webm" />
                <div class="form-text">
                    An .mp4 (H.264) or .webm file, up to 25 MB. A 15&ndash;30 second clip is usually 1&ndash;3 MB.
                </div>
            </div>

            <p class="text-muted text-center my-2">or</p>

            <div class="mb-3">
                <label asp-for="VideoUrl" class="form-label"></label>
                <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                <div class="form-text">
                    A YouTube link (youtube.com or youtu.be), or an https link straight to an .mp4 / .webm file.
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="PosterUrl" class="form-label"></label>
                <input asp-for="PosterUrl" class="form-control" placeholder="https://..." />
                <div class="form-text">Optional. Only used for direct .mp4/.webm links; uploaded files show their first frame and YouTube its own preview.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Add clip</button>
                <a asp-action="Clips" class="btn btn-outline-light">Cancel</a>
            </div>
        </form>
    </div>
</section>
