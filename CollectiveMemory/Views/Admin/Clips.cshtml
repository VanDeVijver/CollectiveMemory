@model CollectiveMemory.ViewModels.AdminClipsViewModel
@{
    ViewData["Title"] = "Manage clips";
    ViewData["ClipDelete"] = true;
}

<section class="cm-section">
    <div class="container">
        <partial name="_AdminTabs" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h1 class="cm-section-title mb-0">Manage clips</h1>
            <a asp-action="CreateClip" class="btn btn-primary">Add a clip</a>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <p class="cm-section-lead">
            The website shows clips three at a time, newest first. This is how they look to visitors.
        </p>

        @if (Model.Clips.Any())
        {
            <div class="row gy-4 mt-1">
                @foreach (var clip in Model.Clips)
                {
                    <div class="col-md-6 col-lg-4">
                        <partial name="_ClipItem" model="clip" />
                    </div>
                }
            </div>
        }
        else
        {
            <p>No clips yet. Use "Add a clip" to add the first one.</p>
        }
    </div>
</section>
