@model CollectiveMemory.ViewModels.SongbookViewModel
@{
    ViewData["Title"] = "Songbook";
}

<section class="cm-section">
    <div class="container">
        <partial name="_AdminTabs" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h1 class="cm-section-title mb-0">Songbook</h1>
            <a asp-action="New" class="btn btn-primary">Add a song</a>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <p class="cm-section-lead">
            Every song the band plays. Build a setlist for a show by picking songs from here.
            Only logged-in band members can see this page.
        </p>

        @if (Model.Songs.Any())
        {
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Song</th>
                            <th>Artist</th>
                            <th>Key</th>
                            <th>Notes</th>
                            <th class="text-end">In setlists</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var song in Model.Songs)
                        {
                            <tr>
                                <td><strong>@song.Title</strong></td>
                                <td>@song.Artist</td>
                                <td>@song.Key</td>
                                <td>@song.Notes</td>
                                <td class="text-end">@song.SetlistCount</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@song.Id" class="btn btn-sm btn-outline-light">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@song.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this song from the songbook@(song.SetlistCount > 0 ? " and from " + song.SetlistCount + " setlist(s)" : "")?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>The songbook is empty. Use "Add a song" to add the first one.</p>
        }
    </div>
</section>
