@model CollectiveMemory.ViewModels.CalendarViewModel
@{
    ViewData["Title"] = "Calendar";
    string[] heads = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    var en = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

<section class="cm-section">
    <div class="container">
        <partial name="_AdminTabs" />

        <h1 class="cm-section-title">Rehearsal calendar</h1>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["AdminError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }


        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-4 mb-3">
            <a asp-action="Index" asp-route-month="@Model.PrevMonth" class="btn btn-sm btn-outline-light" aria-label="Previous month">&larr;</a>
            <h2 class="cm-section-subtitle mb-0">@Model.Title</h2>
            <div class="d-flex gap-2">
                <a asp-action="Index" asp-route-month="@Model.ThisMonth" class="btn btn-sm btn-outline-light">Today</a>
                <a asp-action="Index" asp-route-month="@Model.NextMonth" class="btn btn-sm btn-outline-light" aria-label="Next month">&rarr;</a>
            </div>
        </div>

        <div class="cm-cal" role="grid" aria-label="@Model.Title">
            @foreach (var head in heads)
            {
                <div class="cm-cal-head" role="columnheader">@head</div>
            }

            @foreach (var week in Model.Weeks)
            {
                @foreach (var day in week)
                {
                    var classes = "cm-cal-day"
                        + (day.InMonth ? "" : " is-outside")
                        + (day.IsPast ? " is-past" : "")
                        + (day.IsToday ? " is-today" : "")
                        + (day.IsBlocked ? " is-blocked" : "")
                        + (day.Show is not null ? " is-show" : "")
                        + (day.IsSelected ? " is-selected" : "");
                    var label = day.Date.ToString("dddd d MMMM", en);

                    if (day.Selectable)
                    {
                        <a asp-action="Index" asp-route-month="@Model.Month" asp-route-day="@day.Date.ToString("yyyy-MM-dd")"
                           class="@classes" aria-label="@label@(day.IsBlocked ? ", can't rehearse" : "")" role="gridcell">
                            <span class="cm-cal-num">@day.Date.Day</span>
                            @if (day.IsBlocked)
                            {
                                <span class="cm-cal-label">Can't rehearse</span>
                                @if (!string.IsNullOrWhiteSpace(day.Note))
                                {
                                    <span class="cm-cal-note">@day.Note</span>
                                }
                            }
                        </a>
                    }
                    else
                    {
                        <div class="@classes" role="gridcell" aria-disabled="true"
                             aria-label="@label@(day.Show is not null ? ", show at " + day.Show.Venue : "")"
                             title="@(day.Show is not null ? $"Show: {day.Show.Venue}, {day.Show.City}" : "")">
                            <span class="cm-cal-num">@day.Date.Day</span>
                            @if (day.Show is not null)
                            {
                                <span class="cm-cal-label">Show</span>
                                <span class="cm-cal-note">@day.Show.Venue</span>
                            }
                        </div>
                    }
                }
            }
        </div>

        <ul class="cm-cal-legend list-inline mt-3 mb-0">
            <li class="list-inline-item"><span class="cm-cal-swatch"></span> Free</li>
            <li class="list-inline-item"><span class="cm-cal-swatch is-blocked"></span> Can't rehearse</li>
            <li class="list-inline-item"><span class="cm-cal-swatch is-show"></span> Show</li>
        </ul>

        @if (Model.Selected is { } sel)
        {
            <div class="cm-newsletter-card mt-4">
                <h2 class="cm-card-title mb-3">@sel.Date.ToString("dddd d MMMM yyyy", en)</h2>

                <form asp-action="Set" method="post" class="d-flex gap-2 flex-wrap align-items-end">
                    <input type="hidden" name="date" value="@sel.Date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="month" value="@Model.Month" />
                    <div class="flex-grow-1" style="min-width: 14rem;">
                        <label for="note" class="form-label">Note (who or why, optional)</label>
                        <input id="note" name="note" value="@sel.Note" maxlength="200" class="form-control"
                               placeholder="e.g. Seppe: exam" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        @(sel.IsBlocked ? "Save note" : "Can't rehearse this day")
                    </button>
                </form>

                @if (sel.IsBlocked)
                {
                    <form asp-action="Clear" method="post" class="mt-3">
                        <input type="hidden" name="date" value="@sel.Date.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="month" value="@Model.Month" />
                        <button type="submit" class="btn btn-sm btn-outline-light">Free this day again</button>
                    </form>
                }
            </div>
        }
        else
        {
            <p class="text-muted mt-3 mb-0">Click a day to mark it.</p>
        }

        @if (Model.Upcoming.Any())
        {
            <h2 class="cm-section-subtitle mt-5">Coming up: can't rehearse</h2>
            <ul class="list-unstyled mt-2">
                @foreach (var u in Model.Upcoming)
                {
                    <li class="mb-1">
                        <strong>@u.Date.ToString("ddd d MMM", en)</strong>
                        @if (!string.IsNullOrWhiteSpace(u.Note))
                        {
                            <span> &middot; @u.Note</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>
